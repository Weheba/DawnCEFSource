+// Chromium's MP4 parser (Media Source) prepends an ADTS header to every AAC
+// frame whose config fits ADTS. The converter is set up for raw access units
+// with the esds magic cookie, so such a header must not reach it. FFmpegDemuxer
+// (plain src) hands over raw frames because NeedsBitstreamConversion() is false.
+// Returns the size of a single-frame ADTS header that spans exactly |data|, or 0.
+size_t AdtsHeaderSize(base::span<const uint8_t> data) {
+  if (data.size() < 7 || data[0] != 0xFF || (data[1] & 0xF6) != 0xF0) {
+    return 0;
+  }
+  const size_t header_size = (data[1] & 0x01) ? 7 : 9;
+  const size_t frame_length = ((data[3] & 0x03) << 11) | (data[4] << 3) |
+                              ((data[5] >> 5) & 0x07);
+  const bool single_raw_block = (data[6] & 0x03) == 0;
+  if (!single_raw_block || frame_length != data.size() ||
+      data.size() <= header_size) {
+    return 0;
+  }
+  return header_size;
+}
+
+// An HE-AAC or HE-AAC v2 magic cookie describes several layers, and
+// kAudioFormatProperty_FormatInfo returns only the AAC-LC core: half the output
+// sample rate and half the frames per packet, without SBR or PS. Replaces
+// |format| with the richest layer the system can decode, as AudioQueue and
+// AVFoundation do. Leaves |format| alone for a single-layer stream.
+void SelectRichestDecodableLayer(base::span<const uint8_t> magic_cookie,
+                                 AudioStreamBasicDescription* format) {
+  AudioFormatInfo info = {};
+  info.mASBD = *format;
+  info.mMagicCookie = magic_cookie.data();
+  info.mMagicCookieSize = magic_cookie.size();
+  UInt32 size = 0;
+  if (AudioFormatGetPropertyInfo(kAudioFormatProperty_FormatList, sizeof(info),
+                                 &info, &size) != noErr ||
+      size < sizeof(AudioFormatListItem)) {
+    return;
+  }
+  std::vector<AudioFormatListItem> layers(size / sizeof(AudioFormatListItem));
+  size = layers.size() * sizeof(AudioFormatListItem);
+  if (AudioFormatGetProperty(kAudioFormatProperty_FormatList, sizeof(info),
+                             &info, &size, layers.data()) != noErr) {
+    return;
+  }
+  layers.resize(size / sizeof(AudioFormatListItem));
+
+  UInt32 ids_size = 0;
+  if (AudioFormatGetPropertyInfo(kAudioFormatProperty_DecodeFormatIDs, 0,
+                                 nullptr, &ids_size) != noErr) {
+    return;
+  }
+  std::vector<UInt32> decodable(ids_size / sizeof(UInt32));
+  ids_size = decodable.size() * sizeof(UInt32);
+  if (AudioFormatGetProperty(kAudioFormatProperty_DecodeFormatIDs, 0, nullptr,
+                             &ids_size, decodable.data()) != noErr) {
+    return;
+  }
+  decodable.resize(ids_size / sizeof(UInt32));
+
+  // The list runs from the richest layer down to the AAC-LC core.
+  for (const AudioFormatListItem& layer : layers) {
+    if (std::ranges::find(decodable, layer.mASBD.mFormatID) !=
+        decodable.end()) {
+      *format = layer.mASBD;
+      return;
+    }
+  }
+}
