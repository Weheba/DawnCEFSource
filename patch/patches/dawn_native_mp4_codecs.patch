+    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x44, 0x88, 0x03, 0x80,
+};
+constexpr uint8_t kDawnHeAacFrame5[] = {
+    0x21, 0x0b, 0x43, 0xc8, 0x2c, 0xc2, 0x1f, 0x10, 0x3c, 0x26, 0x8f, 0xfb,
+    0x80, 0x00, 0x00, 0x00, 0x00, 0x00, 0x37, 0x81, 0x68, 0x08, 0x40, 0x00,
+    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x0b, 0xde, 0xbd, 0xe0,
+    0x70,
+};
+constexpr uint8_t kDawnHeAacFrame6[] = {
+    0x21, 0x0b, 0x43, 0xd0, 0x2c, 0xc2, 0x1f, 0x10, 0x3b, 0xed, 0x1f, 0xf7,
+    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x6e, 0xd0, 0x10, 0xa8, 0x00, 0x00,
+    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0xe0,
+};
+constexpr uint8_t kDawnHeAacFrame7[] = {
+    0x21, 0x0b, 0x43, 0xc8, 0x2c, 0xc2, 0x1f, 0x10, 0x3c, 0x06, 0x8f, 0xfb,
+    0x80, 0x00, 0x00, 0x00, 0x00, 0x00, 0x37, 0x68, 0x08, 0x54, 0x00, 0x00,
+    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x70,
+};
+
+namespace {
+
+// Decodes the access units above, configured the way FFmpegDemuxer configures
+// HE-AAC (48 kHz), and returns the output. |drain| ends with an EOS buffer.
+std::vector<scoped_refptr<AudioBuffer>> DecodeDawnHeAac(AudioDecoder* decoder,
+                                                        bool drain) {
+  const AudioDecoderConfig config(
+      AudioCodec::kAAC, kSampleFormatF32, CHANNEL_LAYOUT_STEREO, 48000,
+      std::vector<uint8_t>(std::begin(kDawnHeAacAsc), std::end(kDawnHeAacAsc)),
+      EncryptionScheme::kUnencrypted);
+
+  bool initialized = false;
+  std::vector<scoped_refptr<AudioBuffer>> outputs;
+  decoder->Initialize(
+      config, nullptr,
+      base::BindOnce([](bool* ok, DecoderStatus status) { *ok = status.is_ok(); },
+                     base::Unretained(&initialized)),
+      base::BindRepeating(
+          [](std::vector<scoped_refptr<AudioBuffer>>* out,
+             scoped_refptr<AudioBuffer> buffer) {
+            out->push_back(std::move(buffer));
+          },
+          base::Unretained(&outputs)),
+      base::DoNothing());
+  base::RunLoop().RunUntilIdle();
+  EXPECT_TRUE(initialized);
+  if (!initialized) {
+    return outputs;
+  }
+
+  const base::span<const uint8_t> frames[] = {
+      kDawnHeAacFrame0,
+      kDawnHeAacFrame1,
+      kDawnHeAacFrame2,
+      kDawnHeAacFrame3,
+      kDawnHeAacFrame4,
+      kDawnHeAacFrame5,
+      kDawnHeAacFrame6,
+      kDawnHeAacFrame7};
+  const base::TimeDelta frame_duration = base::Microseconds(42667);
+  std::vector<scoped_refptr<DecoderBuffer>> buffers;
+  for (size_t i = 0; i < std::size(frames); ++i) {
+    scoped_refptr<DecoderBuffer> buffer = DecoderBuffer::CopyFrom(frames[i]);
+    buffer->set_timestamp(frame_duration * static_cast<int>(i));
+    buffer->set_duration(frame_duration);
+    buffer->set_is_key_frame(true);
+    buffers.push_back(std::move(buffer));
+  }
+  if (drain) {
+    buffers.push_back(DecoderBuffer::CreateEOSBuffer());
+  }
+  for (size_t i = 0; i < buffers.size(); ++i) {
+    bool decoded = false;
+    decoder->Decode(
+        std::move(buffers[i]),
+        base::BindOnce([](bool* ok, DecoderStatus status) { *ok = status.is_ok(); },
+                       base::Unretained(&decoded)));
+    base::RunLoop().RunUntilIdle();
+    EXPECT_TRUE(decoded) << "buffer " << i;
+  }
+  return outputs;
+}
+
+}  // namespace
+#endif
+
+#if BUILDFLAG(IS_MAC) && BUILDFLAG(USE_PROPRIETARY_CODECS)
+// AudioToolbox must decode the SBR layer: 2048 frames at 48 kHz per access
+// unit. The AAC-LC core alone gives 1024 frames per access unit, which played
+// at the stream's 48 kHz runs at twice the speed and pitch.
+TEST(AudioToolboxHeAacTest, Dawn_DecodesSbrLayer) {
+  base::test::SingleThreadTaskEnvironment task_environment;
+  AudioToolboxAudioDecoder decoder(std::make_unique<NullMediaLog>());
+  const std::vector<scoped_refptr<AudioBuffer>> outputs =
+      DecodeDawnHeAac(&decoder, /*drain=*/false);
+
+  // The converter trims its decoder delay from the first output.
+  ASSERT_GE(outputs.size(), 7u);
+  for (size_t i = 0; i < outputs.size(); ++i) {
+    SCOPED_TRACE(base::StringPrintf("output %" PRIuS, i));
+    EXPECT_EQ(48000, outputs[i]->sample_rate());
+    EXPECT_EQ(2, outputs[i]->channel_count());
+    if (i == 0) {
+      EXPECT_LE(outputs[i]->frame_count(), 2048);
+    } else {
+      EXPECT_EQ(2048, outputs[i]->frame_count());
+    }
+  }
+}
+#endif
+
+#if BUILDFLAG(IS_WIN) && BUILDFLAG(USE_PROPRIETARY_CODECS)
+// Media Foundation must also decode the SBR layer: 48 kHz output that lasts as
+// long as the input. The AAC-LC core alone gives half the frames.
+TEST(MediaFoundationHeAacTest, Dawn_DecodesSbrLayer) {
+  base::test::SingleThreadTaskEnvironment task_environment;
+  base::win::ScopedCOMInitializer com_initializer;
+  std::unique_ptr<AudioDecoder> decoder = MediaFoundationAudioDecoder::Create();
+  ASSERT_TRUE(decoder);
+  const std::vector<scoped_refptr<AudioBuffer>> outputs =
+      DecodeDawnHeAac(decoder.get(), /*drain=*/true);
+
+  ASSERT_FALSE(outputs.empty());
+  int frames = 0;
+  for (size_t i = 0; i < outputs.size(); ++i) {
+    SCOPED_TRACE(base::StringPrintf("output %" PRIuS, i));
+    EXPECT_EQ(48000, outputs[i]->sample_rate());
+    EXPECT_EQ(2, outputs[i]->channel_count());
+    frames += outputs[i]->frame_count();
+  }
+  // Eight access units of 2048 frames, less the decoder delay.
+  EXPECT_GT(frames, 6 * 2048);
+  EXPECT_LE(frames, 8 * 2048);
+}
+#endif
